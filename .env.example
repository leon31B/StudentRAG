# NVIDIA API Configuration
# Obtain your free API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# NVIDIA Embedding Model (nemotron-3.5-embed-1b)
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# NVIDIA LLM for Generation
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Alternative: deepseek-ai/deepseek-r1

# RAG Pipeline Configuration
INDEX_DIR=./data/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
